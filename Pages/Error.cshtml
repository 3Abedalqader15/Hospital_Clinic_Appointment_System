@page
@model ErrorModel
@{
    ViewData["Title"] = "Error - MediClinic";
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="fas fa-exclamation-triangle text-danger" style="font-size: 5rem; opacity: 0.8;"></i>
    </div>

    <h1 class="display-1 fw-bold text-danger mb-2">Oops!</h1>
    <h2 class="fs-4 text-secondary mb-4">An error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <div class="card border-0 bg-light mb-4 mx-auto" style="max-width: 500px;">
            <div class="card-body">
                <strong class="d-block mb-2">Request ID:</strong>
                <code class="text-break text-danger">@Model.RequestId</code>
            </div>
        </div>
    }

    <div class="mb-4">
        <a href="/" class="btn btn-primary btn-lg">
            <i class="fas fa-home me-2"></i>Return to Home
        </a>
    </div>
</div>

<div class="row my-5">
    <div class="col-md-4 mx-auto text-center">
        <div class="card border-0 h-100">
            <div class="card-body">
                <i class="fas fa-life-ring text-primary" style="font-size: 2.5rem; margin-bottom: 1rem;"></i>
                <h5 class="fw-bold">Need Help?</h5>
                <p class="text-secondary small">Contact our support team for assistance.</p>
                <a href="mailto:support@mediClinic.com" class="text-primary fw-bold text-decoration-none">
                    support@mediClinic.com
                </a>
            </div>
        </div>
    </div>
</div>
