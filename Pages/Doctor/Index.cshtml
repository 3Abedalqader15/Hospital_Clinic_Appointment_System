@page
@model Hospital_Clinic_Appointment_System.Pages.Doctor.IndexModel
@{
    ViewData["Title"] = "Doctor Dashboard";
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

<div class="card border-0 mb-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="row g-0">
            <div class="col-md-4 col-lg-3 bg-light-primary text-center p-4 d-flex flex-column justify-content-center align-items-center border-end">
                <div class="rounded-circle bg-white d-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-user-md fa-2x text-primary"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">Dr. @Model.Doctor?.Name</h5>
                <span class="badge bg-primary">@Model.Doctor?.Specialization</span>
            </div>
            <div class="col-md-8 col-lg-9 p-4">
                <h6 class="text-uppercase fw-bold text-muted mb-3"><i class="fas fa-info-circle me-2"></i>Contact & Details</h6>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <small class="text-muted d-block">Email Address</small>
                        <span class="fw-medium text-dark"><i class="far fa-envelope text-primary me-2"></i>@Model.Doctor?.Email</span>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <small class="text-muted d-block">Phone Number</small>
                        <span class="fw-medium text-dark"><i class="fas fa-phone-alt text-primary me-2"></i>@Model.Doctor?.Phone_Number</span>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <small class="text-muted d-block">Experience</small>
                        <span class="fw-medium text-dark"><i class="fas fa-briefcase text-primary me-2"></i>@Model.Doctor?.ExperienceYears years</span>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <small class="text-muted d-block">Account Status</small>
                        @if(Model.Doctor?.IsActive == true) {
                            <span class="badge badge-success"><i class="fas fa-check-circle me-1"></i>Active</span>
                        } else {
                            <span class="badge badge-danger"><i class="fas fa-times-circle me-1"></i>Inactive</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Upcoming Appointments</h5>
        <a asp-page="/Doctor/Appointments" class="btn btn-sm btn-outline-primary">Manage</a>
    </div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.Appointments)
                {
                    <tr>
                        <td>@appointment.Id</td>
                        <td>@appointment.Patient?.Name</td>
                        <td>@appointment.AppointmentDate.ToString("g")</td>
                        <td>
                            @if(appointment.Status == "Pending") {
                                <span class="badge badge-warning"><i class="fas fa-clock me-1"></i> @appointment.Status</span>
                            } else if (appointment.Status == "Confirmed") {
                                <span class="badge badge-success"><i class="fas fa-check-circle me-1"></i> @appointment.Status</span>
                            } else if (appointment.Status == "Cancelled") {
                                <span class="badge badge-danger"><i class="fas fa-times-circle me-1"></i> @appointment.Status</span>
                            } else {
                                <span class="badge badge-primary">@appointment.Status</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Appointments.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No appointments scheduled.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
