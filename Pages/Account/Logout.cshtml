@page
@model Hospital_Clinic_Appointment_System.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Sign Out";
}

<div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header">
                <h4 class="mb-0"><i class="fas fa-sign-out-alt me-2 text-primary"></i>Sign Out</h4>
            </div>
            <div class="card-body">
                <p class="mb-4 text-secondary">Are you sure you want to sign out?</p>
                <form method="post">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
