@page
@model Hospital_Clinic_Appointment_System.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        background-color: #f0f8ff; /* Light bluish background */
        font-family: 'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    
    .login-container {
        min-height: calc(100vh - 150px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    .login-card {
        border: none;
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        background: #ffffff;
    }

    .login-brand-side {
        background: #045c85; /* Dark blue from the image */
        color: white;
        padding: 4rem 3rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        border-top-left-radius: 24px;
        border-bottom-left-radius: 24px;
        position: relative;
    }
    
    /* Decorative elements to match the image's rounded cutouts */
    .login-brand-side::after {
        content: '';
        position: absolute;
        bottom: -50px;
        right: -50px;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }
    .login-brand-side::before {
        content: '';
        position: absolute;
        top: -30px;
        left: -30px;
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }

    .login-form-side {
        padding: 4rem 3rem;
    }

    .form-control {
        border-radius: 12px;
        padding: 0.8rem 1.2rem;
        border: 1px solid #e0e6ed;
        background-color: #f8fafc;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #045c85;
        box-shadow: 0 0 0 0.25rem rgba(4, 92, 133, 0.15);
        background-color: #ffffff;
    }
    
    .input-group-text {
        border-radius: 12px 0 0 12px;
        border: 1px solid #e0e6ed;
        background-color: #f8fafc;
        border-right: none;
        color: #045c85;
    }
    
    .form-control.with-icon {
        border-left: none;
        padding-left: 0;
    }

    .btn-primary-custom {
        background-color: #0fb3b8; /* Teal color for action button */
        border: none;
        border-radius: 12px;
        padding: 0.8rem 2rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        color: white;
    }

    .btn-primary-custom:hover {
        background-color: #0d9ea3;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(15, 179, 184, 0.3);
        color: white;
    }

    .pastel-badge {
        display: inline-block;
        padding: 0.4rem 1rem;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        background-color: #d1e6f0;
        color: #045c85;
    }
    
    .custom-checkbox .form-check-input {
        border-radius: 6px;
        border-color: #cbd5e1;
    }
    .custom-checkbox .form-check-input:checked {
        background-color: #0fb3b8;
        border-color: #0fb3b8;
    }
    
    .auth-link {
        color: #0fb3b8;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
    }
    .auth-link:hover {
        color: #045c85;
    }

    @@media (max-width: 991.98px) {
        .login-brand-side {
            border-bottom-left-radius: 0;
            border-top-right-radius: 24px;
            padding: 3rem 2rem;
        }
        .login-form-side {
            padding: 3rem 2rem;
        }
    }
</style>

<div class="container login-container">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="row g-0 login-card">
                <!-- Branding Side -->
                <div class="col-lg-5 login-brand-side d-none d-lg-flex">
                    <div style="position: relative; z-index: 1;">
                        <div class="mb-4 d-flex align-items-center">
                            <i class="fas fa-heartbeat fa-2x me-2 text-white"></i>
                            <h3 class="fw-bold mb-0 text-white">CareConnect</h3>
                        </div>
                        <h1 class="display-6 fw-bold mb-4">Expert & Passionate Healthcare.</h1>
                        <p class="lead opacity-75 mb-5">Instantly connect with trusted doctors, manage appointments, and access your health records securely.</p>
                        
                        <div class="d-flex align-items-center mt-auto">
                            <div class="d-flex" style="margin-left: 10px;">
                                <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 40px; height: 40px; margin-left: -10px; border: 2px solid #045c85;">
                                    <i class="fas fa-user-md text-primary"></i>
                                </div>
                                <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 40px; height: 40px; margin-left: -10px; border: 2px solid #045c85;">
                                    <i class="fas fa-stethoscope text-primary"></i>
                                </div>
                                <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 40px; height: 40px; margin-left: -10px; border: 2px solid #045c85;">
                                    <i class="fas fa-plus text-primary"></i>
                                </div>
                            </div>
                            <div class="ms-3 small text-white opacity-75">
                                Join our network of healthcare professionals and patients.
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Form Side -->
                <div class="col-lg-7 login-form-side">
                    <div class="text-center text-lg-start mb-5">
                        <span class="pastel-badge">Welcome Back</span>
                        <h2 class="fw-bold text-dark mb-2">Sign in to your account</h2>
                        <p class="text-muted">Enter your credentials to access your dashboard.</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i> @Model.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-medium"></div>

                        <div class="mb-4">
                            <label asp-for="Login.Email" class="form-label fw-semibold text-dark">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent">
                                    <i class="far fa-envelope"></i>
                                </span>
                                <input asp-for="Login.Email" class="form-control with-icon" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Login.Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Login.Password" class="form-label fw-semibold text-dark mb-0">Password</label>
                                <a href="#" class="auth-link small text-decoration-none">Forgot Password?</a>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input asp-for="Login.Password" type="password" class="form-control with-icon" placeholder="Enter your password" />
                            </div>
                            <span asp-validation-for="Login.Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="form-check custom-checkbox mb-4">
                            <input asp-for="Login.RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
                            <label asp-for="Login.RememberMe" class="form-check-label text-muted" for="rememberMe">
                                Keep me signed in
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary-custom w-100 mb-4">
                            Sign In <i class="fas fa-arrow-right ms-2"></i>
                        </button>
                        
                        <div class="text-center mt-3">
                            <span class="text-muted">Don't have an account?</span>
                            <a asp-page="/Account/Register" class="auth-link ms-1">Create one now</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
