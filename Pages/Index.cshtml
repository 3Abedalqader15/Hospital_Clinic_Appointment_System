@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome to MediClinic";
    // We add a specific flag so _Layout can know if it's the landing page
    ViewData["IsLandingPage"] = true;
}

<div class="landing-body">
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-bg-shapes">
            <div class="shape-1"></div>
            <div class="shape-2"></div>
        </div>
        
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 z-index-1">
                    <div class="animate-fade-in-up">
                        <span class="badge bg-white text-primary border rounded-pill px-3 py-2 mb-4 shadow-sm fw-semibold" style="color: var(--landing-secondary) !important; border-color: rgba(14, 165, 233, 0.2) !important;">
                            <i class="fas fa-star me-2" style="color: #fbbf24;"></i> The Future of Healthcare Management
                        </span>
                        
                        <h1 class="hero-title">
                            Healthcare Management <br/>
                            <span class="hero-title-highlight">Reimagined.</span>
                        </h1>
                        
                        <p class="hero-subtitle">
                            Empowering doctors and patients with a seamless, intelligent, and secure platform. Book appointments, manage schedules, and access medical history with unprecedented ease.
                        </p>
                        
                        <div class="d-flex flex-wrap gap-3 hero-buttons">
                            @if (!User.Identity?.IsAuthenticated ?? true)
                            {
                                <a asp-page="/Account/Register" class="btn btn-premium-primary text-decoration-none">
                                    <i class="fas fa-user-plus me-2"></i> Get Started Free
                                </a>
                                <a asp-page="/Account/Login" class="btn btn-premium-outline text-decoration-none">
                                    <i class="fas fa-sign-in-alt me-2"></i> Sign In
                                </a>
                            }
                            else
                            {
                                <a href="#" class="btn btn-premium-primary text-decoration-none">
                                    <i class="fas fa-chart-line me-2"></i> Go to Dashboard
                                </a>
                            }
                        </div>
                        
                        <div class="trust-stats animate-fade-in-up delay-200">
                            <div class="stat-item">
                                <h4>5k+</h4>
                                <p>Active Patients</p>
                            </div>
                            <div class="stat-item">
                                <h4>150+</h4>
                                <p>Expert Doctors</p>
                            </div>
                            <div class="stat-item">
                                <h4>99%</h4>
                                <p>Satisfaction Rate</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-6 d-none d-lg-block position-relative animate-fade-in-up delay-300">
                    <div class="position-relative" style="z-index: 2;">
                        <!-- Floating Dashboard Mockup Representation -->
                        <div class="glass-card p-0 overflow-hidden" style="transform: rotate(2deg) translateY(-20px); box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);">
                            <div class="bg-light p-3 border-bottom d-flex align-items-center gap-2">
                                <div class="rounded-circle" style="width:12px; height:12px; background:#ef4444;"></div>
                                <div class="rounded-circle" style="width:12px; height:12px; background:#f59e0b;"></div>
                                <div class="rounded-circle" style="width:12px; height:12px; background:#10b981;"></div>
                            </div>
                            <div class="p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between mb-4">
                                    <div class="fw-bold" style="color: var(--landing-primary);">Today's Schedule</div>
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">3 Appointments</span>
                                </div>
                                
                                <div class="p-3 rounded mb-3 border border-light" style="background: #f8fafc;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-semibold text-dark"><i class="fas fa-user-circle me-2 text-primary"></i>Ahmed Hassan</div>
                                        <div class="small text-muted">10:00 AM</div>
                                    </div>
                                    <div class="small text-muted"><i class="fas fa-stethoscope me-2"></i>General Checkup</div>
                                </div>
                                
                                <div class="p-3 rounded mb-3 border border-light" style="background: #f8fafc;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-semibold text-dark"><i class="fas fa-user-circle me-2 text-primary"></i>Fatima Ali</div>
                                        <div class="small text-muted">11:30 AM</div>
                                    </div>
                                    <div class="small text-muted"><i class="fas fa-stethoscope me-2"></i>Dental Consultation</div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Floating Element 2 -->
                        <div class="glass-card position-absolute p-3" style="bottom: -20px; left: -40px; z-index: 3; animation: float 6s ease-in-out infinite;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="fas fa-check text-success fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Appointment Confirmed</div>
                                    <div class="small text-muted">Just now</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-5" style="background-color: white; position: relative; z-index: 2;">
        <div class="container py-5">
            <div class="text-center mb-5 animate-fade-in-up">
                <h2 class="display-6 fw-bold mb-3" style="color: var(--landing-primary);">Everything you need to run your clinic</h2>
                <p class="text-muted fs-5 mx-auto" style="max-width: 700px;">A powerful suite of tools designed to simplify your workflow, whether you are a healthcare professional or a patient seeking care.</p>
            </div>
            
            <div class="row g-4">
                <!-- Feature 1 -->
                <div class="col-md-6 col-lg-4 animate-fade-in-up delay-100">
                    <div class="glass-card h-100">
                        <div class="feature-icon-wrapper">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Smart Scheduling</h4>
                        <p class="text-muted mb-0">Book, reschedule, or cancel appointments 24/7 with real-time slot availability. No more double bookings or phone tag.</p>
                    </div>
                </div>
                
                <!-- Feature 2 -->
                <div class="col-md-6 col-lg-4 animate-fade-in-up delay-200">
                    <div class="glass-card h-100">
                        <div class="feature-icon-wrapper">
                            <i class="fas fa-user-md"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Doctor Profiles</h4>
                        <p class="text-muted mb-0">Browse specialized doctors, view their qualifications, working hours, and read verified reviews from other patients.</p>
                    </div>
                </div>
                
                <!-- Feature 3 -->
                <div class="col-md-6 col-lg-4 animate-fade-in-up delay-300">
                    <div class="glass-card h-100">
                        <div class="feature-icon-wrapper">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Secure Records</h4>
                        <p class="text-muted mb-0">Your health data is encrypted and securely stored. Access your appointment history and medical records anytime, securely.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- For Doctors vs For Patients -->
    <section class="py-5" style="background: #f8fafc;">
        <div class="container py-5">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6 animate-fade-in-up">
                    <div class="pe-lg-5">
                        <span class="text-uppercase fw-bold text-primary tracking-wide mb-2 d-block" style="color: var(--landing-secondary) !important;">For Healthcare Providers</span>
                        <h2 class="display-6 fw-bold mb-4" style="color: var(--landing-primary);">Focus on care, not paperwork.</h2>
                        
                        <div class="d-flex align-items-start mb-4">
                            <div class="mt-1 me-3 text-primary"><i class="fas fa-check-circle fs-5" style="color: var(--landing-secondary);"></i></div>
                            <div>
                                <h5 class="fw-bold mb-1">Efficient Dashboard</h5>
                                <p class="text-muted">Manage your daily schedule, view patient details, and handle approvals from a single intuitive interface.</p>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-start mb-4">
                            <div class="mt-1 me-3 text-primary"><i class="fas fa-check-circle fs-5" style="color: var(--landing-secondary);"></i></div>
                            <div>
                                <h5 class="fw-bold mb-1">Automated Reminders</h5>
                                <p class="text-muted">Reduce no-shows with automated SMS and email reminders sent to patients before their appointments.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 animate-fade-in-up delay-200">
                    <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&q=80&w=800" alt="Doctor using tablet" class="img-fluid rounded-4 shadow-lg" style="border: 8px solid white;">
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="py-5 text-center position-relative overflow-hidden" style="background: var(--landing-gradient-1); margin-top: -1px;">
        <div class="container py-5 position-relative z-index-1">
            <h2 class="display-5 fw-bold text-white mb-4">Ready to transform your healthcare experience?</h2>
            <p class="fs-5 text-white text-opacity-75 mb-5 mx-auto" style="max-width: 600px;">Join thousands of patients and doctors who trust MediClinic for their appointment management.</p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-page="/Account/Register" class="btn btn-light btn-lg rounded-pill fw-bold px-5 py-3 text-primary shadow-lg" style="color: var(--landing-secondary) !important;">
                    Create Free Account
                </a>
            </div>
        </div>
        
        <!-- Decorative bg -->
        <div class="position-absolute top-0 start-0 w-100 h-100" style="background-image: radial-gradient(circle at 20% 150%, rgba(255,255,255,0.2) 0%, transparent 50%); z-index: 0;"></div>
    </section>
</div>
