@page
@model Hospital_Clinic_Appointment_System.Pages.Admin.DoctorsModel
@{
    ViewData["Title"] = "Manage Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-user-md me-2 text-primary"></i>Doctors</h2>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<div class="card border-0 mb-4">
    <div class="card-header">
        <h5 class="mb-0">Add Doctor</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">User Account</label>
                <select class="form-select" name="CreateDoctor.User_Id" required>
                    <option value="">Select user</option>
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id">@user.Name (@user.Email)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Name</label>
                <input class="form-control" name="CreateDoctor.Name" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Specialization</label>
                <input class="form-control" name="CreateDoctor.Specialization" />
            </div>
            <div class="col-md-4">
                <label class="form-label">License Number</label>
                <input class="form-control" name="CreateDoctor.LicenseNumber" placeholder="DOC-001" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Experience Years</label>
                <input class="form-control" type="number" name="CreateDoctor.ExperienceYears" min="0" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Profile Picture URL</label>
                <input class="form-control" name="CreateDoctor.profilePictureUrl" />
            </div>
            <div class="col-12">
                <label class="form-label">Bio</label>
                <textarea class="form-control" name="CreateDoctor.Bio" rows="2"></textarea>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="CreateDoctor.isActive" value="true" checked />
                    <label class="form-check-label">Active</label>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Add Doctor</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Doctor</th>
                    <th>Specialization</th>
                    <th>Experience</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doctor in Model.Doctors)
                {
                    <tr>
                        <td>@doctor.Id</td>
                        <td>@doctor.Name</td>
                        <td>@doctor.Specialization</td>
                        <td>@doctor.ExperienceYears years</td>
                        <td>
                            <span class="badge @(doctor.isActive ? "badge-success" : "badge-danger")">
                                @(doctor.isActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Update" class="d-inline-flex flex-wrap gap-2 align-items-center justify-content-end">
                                <input type="hidden" name="UpdateDoctorId" value="@doctor.Id" />
                                <input class="form-control form-control-sm" name="UpdateDoctor.Name" value="@doctor.Name" />
                                <input class="form-control form-control-sm" name="UpdateDoctor.Specialization" value="@doctor.Specialization" />
                                <input class="form-control form-control-sm" type="number" name="UpdateDoctor.ExperienceYears" value="@doctor.ExperienceYears" min="0" />
                                <input class="form-control form-control-sm" name="UpdateDoctor.LicenseNumber" placeholder="License" />
                                <input class="form-control form-control-sm" name="UpdateDoctor.profilePictureUrl" placeholder="Profile URL" />
                                <input type="hidden" name="UpdateDoctor.isActive" value="false" />
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="UpdateDoctor.isActive" value="true" @(doctor.isActive ? "checked" : "") />
                                    <label class="form-check-label">Active</label>
                                </div>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                            </form>
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="DeleteDoctorId" value="@doctor.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Doctors.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No doctors found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
