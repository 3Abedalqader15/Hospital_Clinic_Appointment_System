@page
@model Hospital_Clinic_Appointment_System.Pages.Admin.DoctorsModel
@{
    ViewData["Title"] = "Manage Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fas fa-user-md me-2 text-primary"></i>Doctors</h2>
    <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addDoctorModal">
        <i class="fas fa-plus me-2"></i>Add Doctor
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Add Doctor Modal -->
<div class="modal fade" id="addDoctorModal" tabindex="-1" aria-labelledby="addDoctorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title fw-bold" id="addDoctorModalLabel"><i class="fas fa-user-md me-2 text-primary"></i>Add New Doctor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">User Account</label>
                            <select class="form-select" name="CreateDoctor.User_Id" required>
                                <option value="">Select user...</option>
                                @foreach (var user in Model.Users)
                                {
                                    <option value="@user.Id">@user.Name (@user.Email)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Full Name</label>
                            <input class="form-control" name="CreateDoctor.Name" placeholder="Dr. John Doe" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Specialization</label>
                            <input class="form-control" name="CreateDoctor.Specialization" placeholder="e.g., Cardiology" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">License Number</label>
                            <input class="form-control" name="CreateDoctor.LicenseNumber" placeholder="DOC-001" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Experience (Years)</label>
                            <input class="form-control" type="number" name="CreateDoctor.ExperienceYears" min="0" placeholder="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Profile Picture URL</label>
                            <input class="form-control" name="CreateDoctor.profilePictureUrl" placeholder="https://..." />
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold">Biography</label>
                            <textarea class="form-control" name="CreateDoctor.Bio" rows="3" placeholder="Brief professional background..."></textarea>
                        </div>
                        <div class="col-12 mt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="CreateDoctor.isActive" value="true" checked id="addActiveStatus" />
                                <label class="form-check-label" for="addActiveStatus">Active Status</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Doctor</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-muted fw-bold ps-4">ID</th>
                    <th class="text-muted fw-bold">Doctor Info</th>
                    <th class="text-muted fw-bold">Specialization</th>
                    <th class="text-muted fw-bold">Experience</th>
                    <th class="text-muted fw-bold">Status</th>
                    <th class="text-end text-muted fw-bold pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doctor in Model.Doctors)
                {
                    <tr>
                        <td class="ps-4 fw-medium text-secondary">#@doctor.Id</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                    <i class="fas fa-user-md"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@doctor.Name</div>
                                    <div class="text-muted small">@doctor.Specialization</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-3 py-2">
                                <i class="fas fa-stethoscope me-1"></i> @doctor.Specialization
                            </span>
                        </td>
                        <td class="text-muted">
                            <i class="fas fa-briefcase me-1 text-secondary opacity-50"></i> @doctor.ExperienceYears years
                        </td>
                        <td>
                            @if (doctor.isActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2">
                                    <i class="fas fa-check-circle me-1"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-2">
                                    <i class="fas fa-times-circle me-1"></i> Inactive
                                </span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-2">
                                <!-- Edit Button -->
                                <button type="button" class="btn btn-sm btn-light text-primary hover-shadow" data-bs-toggle="modal" data-bs-target="#editModal-@doctor.Id" title="Edit Doctor">
                                    <i class="fas fa-edit"></i>
                                </button>

                                <!-- Delete Form -->
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this doctor?');">
                                    <input type="hidden" name="DeleteDoctorId" value="@doctor.Id" />
                                    <button type="submit" class="btn btn-sm btn-light text-danger hover-shadow" title="Delete Doctor">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>

                            <!-- Edit Modal for this row -->
                            <div class="modal fade text-start" id="editModal-@doctor.Id" tabindex="-1" aria-labelledby="editModalLabel-@doctor.Id" aria-hidden="true">
                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg">
                                        <div class="modal-header bg-light border-bottom-0">
                                            <h5 class="modal-title fw-bold" id="editModalLabel-@doctor.Id"><i class="fas fa-edit me-2 text-primary"></i>Edit Doctor</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form method="post" asp-page-handler="Update">
                                            <div class="modal-body p-4">
                                                <input type="hidden" name="UpdateDoctorId" value="@doctor.Id" />
                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label text-muted small fw-bold">Full Name</label>
                                                        <input class="form-control" name="UpdateDoctor.Name" value="@doctor.Name" required />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label text-muted small fw-bold">Specialization</label>
                                                        <input class="form-control" name="UpdateDoctor.Specialization" value="@doctor.Specialization" required />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label text-muted small fw-bold">Experience (Years)</label>
                                                        <input class="form-control" type="number" name="UpdateDoctor.ExperienceYears" value="@doctor.ExperienceYears" min="0" />
                                                    </div>
                                                    <div class="col-12 mt-3">
                                                        <input type="hidden" name="UpdateDoctor.isActive" value="false" />
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" name="UpdateDoctor.isActive" value="true" @(doctor.isActive ? "checked" : "") id="editActiveStatus-@doctor.Id" />
                                                            <label class="form-check-label" for="editActiveStatus-@doctor.Id">Active Status</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light border-top-0">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary px-4">Update Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Doctors.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <div class="mb-3"><i class="fas fa-user-md fa-3x opacity-25"></i></div>
                            <p class="mb-0">No doctors found in the system.</p>
                            <small>Click "Add Doctor" to get started.</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
