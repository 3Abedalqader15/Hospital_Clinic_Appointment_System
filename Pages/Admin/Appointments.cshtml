@page
@model Hospital_Clinic_Appointment_System.Pages.Admin.AppointmentsModel
@{
    ViewData["Title"] = "Manage Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-calendar-check me-2 text-primary"></i>Appointments</h2>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<div class="card border-0">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Doctor</th>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Reason</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.Appointments)
                {
                    <tr>
                        <td>@appointment.Id</td>
                        <td>@appointment.DoctorName</td>
                        <td>@appointment.PatientName</td>
                        <td>@appointment.AppointmentDate.ToString("g")</td>
                        <td>
                            @if(appointment.Status == "Pending") {
                                <span class="badge badge-warning"><i class="fas fa-clock me-1"></i> @appointment.Status</span>
                            } else if (appointment.Status == "Confirmed") {
                                <span class="badge badge-success"><i class="fas fa-check-circle me-1"></i> @appointment.Status</span>
                            } else if (appointment.Status == "Cancelled") {
                                <span class="badge badge-danger"><i class="fas fa-times-circle me-1"></i> @appointment.Status</span>
                            } else {
                                <span class="badge badge-primary">@appointment.Status</span>
                            }
                        </td>
                        <td class="text-truncate" style="max-width: 200px;">@appointment.Reason</td>
                        <td class="text-end">
                            <div class="d-flex flex-column gap-2 align-items-end">
                                <form method="post" asp-page-handler="Reschedule" class="d-flex gap-2 align-items-center">
                                    <input type="hidden" name="appointmentId" value="@appointment.Id" />
                                    <input type="datetime-local" name="newAppointmentDate" class="form-control form-control-sm" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Reschedule</button>
                                </form>
                                <form method="post" asp-page-handler="Complete" class="d-flex gap-2 align-items-center">
                                    <input type="hidden" name="appointmentId" value="@appointment.Id" />
                                    <input type="text" name="notes" class="form-control form-control-sm" placeholder="Notes" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Complete</button>
                                </form>
                                <div class="d-flex gap-2 flex-wrap justify-content-end">
                                    <form method="post" asp-page-handler="Cancel">
                                        <input type="hidden" name="appointmentId" value="@appointment.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Cancel</button>
                                    </form>
                                    <form method="post" asp-page-handler="NoShow">
                                        <input type="hidden" name="appointmentId" value="@appointment.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">No-Show</button>
                                    </form>
                                    <form method="post" asp-page-handler="Reminder">
                                        <input type="hidden" name="appointmentId" value="@appointment.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-info">Reminder</button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete">
                                        <input type="hidden" name="appointmentId" value="@appointment.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Appointments.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No appointments found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
