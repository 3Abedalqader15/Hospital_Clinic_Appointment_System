@page
@model Hospital_Clinic_Appointment_System.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

<div class="row g-4 mb-5">
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card border-0 h-100">
            <div class="card-body">
                <div class="stat-icon-box bg-light-primary text-primary-dark">
                    <i class="fas fa-users fs-3"></i>
                </div>
                <div class="stat-number fs-2 fw-bold text-primary">@Model.UsersCount</div>
                <div class="stat-label text-secondary fw-semibold">Total Users</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card border-0 h-100">
            <div class="card-body">
                <div class="stat-icon-box bg-light-success text-success">
                    <i class="fas fa-user-md fs-3"></i>
                </div>
                <div class="stat-number fs-2 fw-bold text-success">@Model.DoctorsCount</div>
                <div class="stat-label text-secondary fw-semibold">Doctors</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card border-0 h-100">
            <div class="card-body">
                <div class="stat-icon-box bg-info-light text-info-dark" style="background: var(--info-light); color: var(--info-dark);">
                    <i class="fas fa-user-injured fs-3"></i>
                </div>
                <div class="stat-number fs-2 fw-bold text-info">@Model.PatientsCount</div>
                <div class="stat-label text-secondary fw-semibold">Patients</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card border-0 h-100">
            <div class="card-body">
                <div class="stat-icon-box bg-warning-light text-warning-dark" style="background: var(--warning-light); color: var(--warning-dark);">
                    <i class="fas fa-calendar-check fs-3"></i>
                </div>
                <div class="stat-number fs-2 fw-bold text-warning">@Model.AppointmentsCount</div>
                <div class="stat-label text-secondary fw-semibold">Appointments</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Recent Appointments</h5>
        <a asp-page="/Admin/Appointments" class="btn btn-sm btn-outline-primary">Manage</a>
    </div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Doctor</th>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.RecentAppointments)
                {
                    <tr>
                        <td>@appointment.Id</td>
                        <td>@appointment.DoctorName</td>
                        <td>@appointment.PatientName</td>
                        <td>@appointment.AppointmentDate.ToString("g")</td>
                        <td>
                            @if(appointment.Status == "Pending") {
                                <span class="badge badge-warning"><i class="fas fa-clock me-1"></i> @appointment.Status</span>
                            } else if (appointment.Status == "Confirmed") {
                                <span class="badge badge-success"><i class="fas fa-check-circle me-1"></i> @appointment.Status</span>
                            } else if (appointment.Status == "Cancelled") {
                                <span class="badge badge-danger"><i class="fas fa-times-circle me-1"></i> @appointment.Status</span>
                            } else {
                                <span class="badge badge-primary">@appointment.Status</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.RecentAppointments.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No appointments found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
