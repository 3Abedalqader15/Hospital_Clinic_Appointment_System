@page
@model Hospital_Clinic_Appointment_System.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card border-0">
            <div class="card-body text-center">
                <div class="stat-number">@Model.UsersCount</div>
                <div class="stat-label">Users</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0">
            <div class="card-body text-center">
                <div class="stat-number">@Model.DoctorsCount</div>
                <div class="stat-label">Doctors</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0">
            <div class="card-body text-center">
                <div class="stat-number">@Model.PatientsCount</div>
                <div class="stat-label">Patients</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0">
            <div class="card-body text-center">
                <div class="stat-number">@Model.AppointmentsCount</div>
                <div class="stat-label">Appointments</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Recent Appointments</h5>
        <a asp-page="/Admin/Appointments" class="btn btn-sm btn-outline-primary">Manage</a>
    </div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Doctor</th>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.RecentAppointments)
                {
                    <tr>
                        <td>@appointment.Id</td>
                        <td>@appointment.DoctorName</td>
                        <td>@appointment.PatientName</td>
                        <td>@appointment.AppointmentDate.ToString("g")</td>
                        <td>
                            <span class="badge badge-primary">@appointment.Status</span>
                        </td>
                    </tr>
                }
                @if (!Model.RecentAppointments.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No appointments found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
