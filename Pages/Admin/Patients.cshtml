@page
@model Hospital_Clinic_Appointment_System.Pages.Admin.PatientsModel
@{
    ViewData["Title"] = "Manage Patients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fas fa-user-injured me-2 text-primary"></i>Patients</h2>
    <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addPatientModal">
        <i class="fas fa-plus me-2"></i>Add Patient
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Add Patient Modal -->
<div class="modal fade" id="addPatientModal" tabindex="-1" aria-labelledby="addPatientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title fw-bold" id="addPatientModalLabel"><i class="fas fa-user-plus me-2 text-primary"></i>Add New Patient</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">User Account</label>
                            <select class="form-select" name="CreatePatient.UserId" required>
                                <option value="">Select user...</option>
                                @foreach (var user in Model.Users)
                                {
                                    <option value="@user.Id">@user.Name (@user.Email)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Full Name</label>
                            <input class="form-control" name="CreatePatient.Name" placeholder="Patient Name" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-muted small fw-bold">Emergency Contact Number</label>
                            <input class="form-control" name="CreatePatient.EmergencyNumber" placeholder="Emergency contact..." />
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold">Medical History</label>
                            <textarea class="form-control" name="CreatePatient.MedicalHistory" rows="3" placeholder="Brief medical history and known allergies..."></textarea>
                        </div>
                        <div class="col-12 mt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="CreatePatient.IsActive" value="true" checked id="addPatientActiveStatus" />
                                <label class="form-check-label" for="addPatientActiveStatus">Active Status</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Patient</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-muted fw-bold ps-4">ID</th>
                    <th class="text-muted fw-bold">Patient Details</th>
                    <th class="text-muted fw-bold">Emergency Contact</th>
                    <th class="text-muted fw-bold">Medical History</th>
                    <th class="text-end text-muted fw-bold pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in Model.Patients)
                {
                    <tr>
                        <td class="ps-4 fw-medium text-secondary">#@patient.Id</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                    <i class="fas fa-user-injured"></i>
                                </div>
                                <div class="fw-bold text-dark">@patient.Name</div>
                            </div>
                        </td>
                        <td>
                            <i class="fas fa-phone-alt me-1 text-secondary opacity-50"></i> 
                            @(string.IsNullOrEmpty(patient.EmergencyNumber) ? "N/A" : patient.EmergencyNumber)
                        </td>
                        <td class="text-muted" style="max-width: 250px;">
                            <div class="text-truncate" title="@patient.MedicalHistory">
                                @(string.IsNullOrEmpty(patient.MedicalHistory) ? "None provided" : patient.MedicalHistory)
                            </div>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-2">
                                <!-- Edit Button -->
                                <button type="button" class="btn btn-sm btn-light text-primary hover-shadow" data-bs-toggle="modal" data-bs-target="#editModal-@patient.Id" title="Edit Patient">
                                    <i class="fas fa-edit"></i>
                                </button>

                                <!-- Delete Form -->
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this patient?');">
                                    <input type="hidden" name="DeletePatientId" value="@patient.Id" />
                                    <button type="submit" class="btn btn-sm btn-light text-danger hover-shadow" title="Delete Patient">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>

                            <!-- Edit Modal for this row -->
                            <div class="modal fade text-start" id="editModal-@patient.Id" tabindex="-1" aria-labelledby="editModalLabel-@patient.Id" aria-hidden="true">
                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg">
                                        <div class="modal-header bg-light border-bottom-0">
                                            <h5 class="modal-title fw-bold" id="editModalLabel-@patient.Id"><i class="fas fa-edit me-2 text-primary"></i>Edit Patient Details</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form method="post" asp-page-handler="Update">
                                            <div class="modal-body p-4">
                                                <input type="hidden" name="UpdatePatientId" value="@patient.Id" />
                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label text-muted small fw-bold">Full Name</label>
                                                        <input class="form-control" name="UpdatePatient.Name" value="@patient.Name" required />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label text-muted small fw-bold">Emergency Contact Number</label>
                                                        <input class="form-control" name="UpdatePatient.EmergencyNumber" value="@patient.EmergencyNumber" />
                                                    </div>
                                                    <div class="col-12">
                                                        <label class="form-label text-muted small fw-bold">Medical History</label>
                                                        <textarea class="form-control" name="UpdatePatient.MedicalHistory" rows="3">@patient.MedicalHistory</textarea>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light border-top-0">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary px-4">Update Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Patients.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <div class="mb-3"><i class="fas fa-user-injured fa-3x opacity-25"></i></div>
                            <p class="mb-0">No patients found in the system.</p>
                            <small>Click "Add Patient" to get started.</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
