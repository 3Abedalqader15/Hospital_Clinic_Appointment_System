@page
@model Hospital_Clinic_Appointment_System.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fas fa-users me-2 text-primary"></i>Users</h2>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<div class="card border-0">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>User Details</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>
                            <form method="post" asp-page-handler="Update" class="d-flex flex-column flex-lg-row gap-2 align-items-start align-items-lg-center">
                                <input type="hidden" name="UpdateUserId" value="@user.Id" />
                                <input class="form-control form-control-sm" name="UpdateUser.Name" value="@user.Name" />
                                <input class="form-control form-control-sm" name="UpdateUser.Email" value="@user.Email" />
                                <input class="form-control form-control-sm" name="UpdateUser.Phone_Number" value="@user.Phone_Number" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                            </form>
                        </td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="DeleteUserId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">No users found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
