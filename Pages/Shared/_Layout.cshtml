<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MediClinic - Hospital and Clinic Appointment Management System" />
    <title>@ViewData["Title"] - MediClinic</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">

    <!-- Modern CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-design.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Hospital_Clinic_Appointment_System.styles.css" asp-append-version="true" />
</head>
<body class="mediClinic-body">
    @{
        var isAuthenticated = Context.User?.Identity?.IsAuthenticated == true;
        var isAdmin = Context.User?.IsInRole("Admin") == true;
        var isDoctor = Context.User?.IsInRole("Doctor") == true;
        var isPatient = Context.User?.IsInRole("Patient") == true;
        var dashboardPage = isAdmin ? "/Admin/Index" : isDoctor ? "/Doctor/Index" : isPatient ? "/Patient/Index" : "/Index";
        var isLandingPage = ViewData["IsLandingPage"] as bool? == true;
        var navbarClass = isLandingPage ? "navbar-landing" : "mediClinic-navbar";
    }
    <!-- Navigation Bar -->
    <header class="mediClinic-header">
        <nav class="navbar navbar-expand-lg navbar-dark @navbarClass sticky-top">
            <div class="container-fluid px-4">
                <!-- Brand Logo -->
                <a class="navbar-brand mediClinic-brand" asp-area="" asp-page="/Index" title="MediClinic Home">
                    <div class="brand-wrapper">
                        <div class="brand-icon-box">
                            <i class="fas fa-hospital-user"></i>
                        </div>
                        <div class="brand-text">
                            <span class="brand-name">Medi</span><span class="brand-accent">Clinic</span>
                        </div>
                    </div>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler mediClinic-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" 
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Menu -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link mediClinic-nav-link" asp-area="" asp-page="/Index">
                                <i class="fas fa-home me-2"></i>Home
                            </a>
                        </li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link mediClinic-nav-link" asp-page="@dashboardPage">
                                    <i class="fas fa-chart-line me-2"></i>Dashboard
                                </a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link mediClinic-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-tools me-2"></i>Admin
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Admin/Index">Overview</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Users">Users</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Doctors">Doctors</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Patients">Patients</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Appointments">Appointments</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/TimeSlots">Time Slots</a></li>
                                </ul>
                            </li>
                        }
                        @if (isDoctor)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link mediClinic-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-md me-2"></i>Doctor
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Doctor/Index">Overview</a></li>
                                    <li><a class="dropdown-item" asp-page="/Doctor/Appointments">Appointments</a></li>
                                    <li><a class="dropdown-item" asp-page="/Doctor/TimeSlots">Time Slots</a></li>
                                </ul>
                            </li>
                        }
                        @if (isPatient)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link mediClinic-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-injured me-2"></i>Patient
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Patient/Index">Overview</a></li>
                                    <li><a class="dropdown-item" asp-page="/Patient/Doctors">Doctors</a></li>
                                    <li><a class="dropdown-item" asp-page="/Patient/Appointments">Appointments</a></li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link mediClinic-nav-link" asp-area="" asp-page="/Privacy">
                                <i class="fas fa-shield-alt me-2"></i>Privacy
                            </a>
                        </li>
                        @if (!isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link mediClinic-nav-link @(isLandingPage ? "btn-nav-login" : "")" asp-page="/Account/Login">
                                    <i class="fas fa-sign-in-alt me-2"></i>Login
                                </a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link mediClinic-nav-link @(isLandingPage ? "btn-nav-signup" : "")" asp-page="/Account/Register">
                                    <i class="fas fa-user-plus me-2"></i>Register
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item d-flex align-items-center text-white px-3">
                                <i class="fas fa-user-circle me-2"></i>@(Context.User?.Identity?.Name ?? "User")
                            </li>
                            <li class="nav-item">
                                <form method="post" action="/Account/Logout" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-light">
                                        <i class="fas fa-sign-out-alt me-1"></i>Logout
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" class="mediClinic-main">
        <div class="container-fluid px-4">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="mediClinic-footer">
        <div class="container-fluid px-4">
            <div class="row py-5">
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="footer-section">
                        <h6 class="text-white fw-bold mb-3">
                            <i class="fas fa-hospital-user me-2 text-accent"></i>MediClinic
                        </h6>
                        <p class="text-muted-light small">Providing quality healthcare appointment management services for modern clinics and hospitals.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="footer-section">
                        <h6 class="text-white fw-bold mb-3">
                            <i class="fas fa-link me-2 text-accent"></i>Quick Links
                        </h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2"><a asp-area="" asp-page="/Index" class="text-muted-light footer-link">Home</a></li>
                            <li class="mb-2"><a asp-area="" asp-page="/Privacy" class="text-muted-light footer-link">Privacy Policy</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="footer-section">
                        <h6 class="text-white fw-bold mb-3">
                            <i class="fas fa-phone me-2 text-accent"></i>Contact Us
                        </h6>
                        <p class="text-muted-light small mb-2">
                            <i class="fas fa-phone me-2"></i>+1 (555) 123-4567
                        </p>
                        <p class="text-muted-light small mb-0">
                            <i class="fas fa-envelope me-2"></i>info@mediClinic.com
                        </p>
                    </div>
                </div>
            </div>
            <div class="footer-divider"></div>
            <div class="py-3">
                <p class="text-center text-muted-light small mb-0">
                    &copy; <span id="year">2026</span> MediClinic Appointment System. All rights reserved. | Designed with <i class="fas fa-heart text-danger"></i> for healthcare excellence.
                </p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('year').textContent = new Date().getFullYear();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
