@page
@model Hospital_Clinic_Appointment_System.Pages.Patient.AppointmentsModel
@{
    ViewData["Title"] = "My Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fas fa-calendar-check me-2 text-primary"></i>My Appointments</h2>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive" style="min-height: 400px;">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-muted fw-bold ps-4">ID</th>
                    <th class="text-muted fw-bold">Doctor</th>
                    <th class="text-muted fw-bold">Date & Time</th>
                    <th class="text-muted fw-bold">Status</th>
                    <th class="text-end text-muted fw-bold pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.Appointments)
                {
                    <tr>
                        <td class="ps-4 fw-medium text-secondary">#@appointment.Id</td>
                        <td>
                            <div class="fw-bold text-dark"><i class="fas fa-user-md me-1 text-primary"></i> @appointment.DoctorName</div>
                        </td>
                        <td>
                            <div class="text-dark"><i class="far fa-calendar-alt me-1 text-secondary"></i> @appointment.AppointmentDate.ToString("MMM dd, yyyy")</div>
                            <div class="small text-muted"><i class="far fa-clock me-1"></i> @appointment.AppointmentDate.ToString("hh:mm tt")</div>
                        </td>
                        <td>
                            @if(appointment.Status == "Pending") {
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-2"><i class="fas fa-clock me-1"></i> Pending</span>
                            } else if (appointment.Status == "Confirmed") {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2"><i class="fas fa-check-circle me-1"></i> Confirmed</span>
                            } else if (appointment.Status == "Cancelled") {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-2"><i class="fas fa-times-circle me-1"></i> Cancelled</span>
                            } else {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-2">@appointment.Status</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light hover-shadow dropdown-toggle" type="button" id="actionMenu-@appointment.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="actionMenu-@appointment.Id">
                                    <li>
                                        <button class="dropdown-item text-primary" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@appointment.Id">
                                            <i class="fas fa-calendar-day me-2"></i> Request Reschedule
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                            <input type="hidden" name="appointmentId" value="@appointment.Id" />
                                            <button class="dropdown-item text-danger"><i class="fas fa-ban me-2"></i> Cancel Appointment</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>

                            <!-- Reschedule Modal -->
                            <div class="modal fade text-start" id="rescheduleModal-@appointment.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg">
                                        <div class="modal-header bg-light border-bottom-0">
                                            <h5 class="modal-title fw-bold"><i class="fas fa-calendar-day me-2 text-primary"></i>Reschedule Appointment</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form method="post" asp-page-handler="Reschedule">
                                            <div class="modal-body p-4">
                                                <input type="hidden" name="appointmentId" value="@appointment.Id" />
                                                <div class="mb-3">
                                                    <label class="form-label text-muted small fw-bold">New Date & Time</label>
                                                    <input type="datetime-local" name="newAppointmentDate" class="form-control" value="@appointment.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")" required />
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light border-top-0">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary px-4">Submit Request</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Appointments.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <div class="mb-3"><i class="fas fa-calendar-times fa-3x opacity-25"></i></div>
                            <p class="mb-0">You have no appointments scheduled.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
